# Core application
APP_NAME=Website Builder Auth API
ENVIRONMENT=development

# Database configuration
DATABASE_URL=sqlite:///./auth.db

# JWT / Auth secrets (generate long random strings!)# Generate with: openssl rand -hex 32
ACCESS_TOKEN_SECRET=replace-with-64-char-random
REFRESH_TOKEN_SECRET=replace-with-64-char-random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=30
REFRESH_TOKEN_EXP_MINUTES=10080   # 7 days

# Server configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO

# Redis configuration
REDIS_URL=redis://localhost:6379/0
OTP_TTL_MINUTES=1

# Token blacklist TTL configuration (in seconds)
BLACKLIST_MIN_TTL_SECONDS=3600    # 1 hour minimum
BLACKLIST_MAX_TTL_SECONDS=86400   # 24 hours maximum

# Email configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
